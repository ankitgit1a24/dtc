# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_BOOTSTRAP_PASSWORD: Secure initial passphrase for the super administrator account.
# Used on initial database creation if no admin exists; never overwritten thereafter.
ADMIN_BOOTSTRAP_PASSWORD="CHANGE_ME_SECURE_ADMIN_PASSWORD"

# AGENCY_NOTIFICATION_EMAIL: Email addresses where client form submissions and lead details are automatically dispatched.
# Comma-separated list for multiple recipient inboxes.
AGENCY_NOTIFICATION_EMAIL="narnaul.shersingh@gmail.com, customer@dtcexpresscargo.in"

# Outbound SMTP Mail Relay (Optional for live TLS/SSL dispatch)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="agency@example.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
SMTP_SECURE="false"
SMTP_FROM="DTC Express Dispatch Desk <customer@dtcexpresscargo.in>"

# Real WhatsApp Business API (Optional: configured in .env or via /admin Settings portal)
# Option A: Meta WhatsApp Cloud API (Free tier 1,000 conversations/mo)
WHATSAPP_PROVIDER="meta"
WHATSAPP_PHONE_NUMBER_ID="109283746592834"
WHATSAPP_ACCESS_TOKEN="EAABw..."
WHATSAPP_TEMPLATE_NAME=""

# Option B: Twilio WhatsApp
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Option C: Custom Webhook / Indian Gateway (Interakt / Gupshup / Aisensy)
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_API_KEY=""
